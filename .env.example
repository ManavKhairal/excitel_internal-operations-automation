# Staging credentials — both apps use the same Auth0 login (excitel-prerelease.eu.auth0.com).
# Copy this file to .env and fill in your staging username/email and password.
# Never commit the .env file after filling it.
# If both apps share the same account, set the same values for both.
PROCARE_USERNAME=YOUR_EMAIL_HERE
PROCARE_PASSWORD=YOUR_PASSWORD_HERE
COREHR_USERNAME=YOUR_EMAIL_HERE
COREHR_PASSWORD=YOUR_PASSWORD_HERE

# Production North Procare subscriber synchronization only.
PROCARE_SYNC_USERNAME=
PROCARE_SYNC_PASSWORD=

