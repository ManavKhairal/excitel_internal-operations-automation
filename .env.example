# Staging credentials — both apps use the same Auth0 login (excitel-prerelease.eu.auth0.com).
# Copy this file to .env and fill in your staging username/email and password.
# Never commit the .env file after filling it.
# If both apps share the same account, set the same values for both.
PROCARE_USERNAME=YOUR_EMAIL_HERE
PROCARE_PASSWORD=YOUR_PASSWORD_HERE
COREHR_USERNAME=YOUR_EMAIL_HERE
COREHR_PASSWORD=YOUR_PASSWORD_HERE

# Workforce has independent credentials, even when initially the same as Procare.
WORKFORCE_USERNAME=YOUR_EMAIL_HERE
WORKFORCE_PASSWORD=YOUR_PASSWORD_HERE

# Reserved for a later authorized deposit preview. These are independent of
# the Google Drive connection in ChatGPT. Access tokens are short-lived.
# Live preview remains disabled pending schema/UI inspection.
GOOGLE_SHEETS_ACCESS_TOKEN=
PMA_NORTH_USERNAME=
PMA_NORTH_PASSWORD=
PMA_SOUTH_USERNAME=
PMA_SOUTH_PASSWORD=

# Local dashboard (optional). Defaults to http://127.0.0.1:4310.
# When omitted, a private token is generated in .state/dashboard-token.
# Display it locally with npm run web:token. Never paste it into tickets or logs.
# DASHBOARD_PORT=4310
# DASHBOARD_TOKEN=YOUR_RANDOM_TOKEN_OF_AT_LEAST_32_CHARACTERS

